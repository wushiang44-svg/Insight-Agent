# DeepSeek LLM (https://platform.deepseek.com) - one API key, model is picked per request.
# Check DeepSeek's docs/dashboard for the current valid model names before relying on the defaults below.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Used for search planning, item analysis, and sufficiency checks (many small/cheap calls).
FAST_MODEL=deepseek-v4-flash
# Used only for the final merchant report, where quality matters most.
PRO_MODEL=deepseek-v4-pro

# Reddit app credentials. Requires approval first under the "Responsible Builder" policy:
# https://support.reddithelp.com/hc/en-us/requests/new?ticket_form_id=14868593862164
# Then create/access the app at https://www.reddit.com/prefs/apps -> create app -> type "script"
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=reddit-insight-agent/0.1 by your-reddit-username

# Amazon collector: path to a persistent agent-browser Chrome profile that's
# already been manually logged into Amazon (see collectors/amazon.py docstring
# for the one-time login command). Logged-out sessions can't read full reviews.
# Not needed for the YouTube collector — comments are public, no login required.
AMAZON_AGENT_BROWSER_PROFILE=

# Reddit browser collector (DataSource.REDDIT): a plain, independently-launched
# Chrome instance (NOT agent-browser's own managed browser) that agent-browser
# attaches to via CDP. Requires one-time manual initialization — see
# collectors/reddit_browser.py docstring for the exact command. No Reddit
# login required, unlike Amazon; this profile persists behavioral/session
# trust with Reddit's bot detection, not an authenticated account.
REDDIT_CHROME_EXECUTABLE=
REDDIT_CHROME_PROFILE_DIR=
REDDIT_CHROME_CDP_PORT=9222
REDDIT_BROWSER_MAX_POSTS_PER_QUERY=3
REDDIT_BROWSER_MAX_COMMENTS_PER_POST=50
REDDIT_BROWSER_MIN_COMMENT_COUNT=5
REDDIT_BROWSER_ALLOW_VIEW_MORE_CLICK=true
